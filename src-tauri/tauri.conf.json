{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kai",
  "version": "1.0.0",
  "identifier": "com.aamen.kai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kai",
        "decorations": false,
        "width": 1200,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Amen Allah Arfaoui",
    "copyright": "Copyright © 2026 Amen Allah Arfaoui",
    "category": "Productivity",
    "shortDescription": "Local-first AI chat powered by Ollama",
    "longDescription": "kai is a local-first desktop AI chat application. Conversations are stored in a local SQLite database and responses are generated by an Ollama server running on the same machine, so no conversation data leaves the computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
